# =====================================================================
# deploy/compose 环境变量模板 —— 复制为 .env 后填写真实值
#
# ⚠️ 安全红线：
#   * .env 已加入仓库 .gitignore，绝不提交到 Git；
#   * 密码至少 16 位随机串，云服务器上通过受限 shell / 密钥管理设置；
#   * ragkb_app / ragkb_migrator 密码同时用于 compose 首次初始化（自动执行
#     deploy/ddl/init.sql 的 psql 变量）与应用连接 / 迁移。
# =====================================================================

# PostgreSQL superuser 密码（compose 启动 postgres 时使用）
POSTGRES_PASSWORD=

# MinIO 控制台 / S3 凭证
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# 数据库业务角色密码（供 compose 首次初始化 + 应用连接 + 迁移）
#   * compose 在 PostgreSQL 首次启动（pgdata 卷为空）时自动执行
#     deploy/ddl/init.sql，创建 ragkb_owner / ragkb_migrator / ragkb_app 角色；
#   * ragkb_app 密码需与 service 的 RAGKB_DB_PASSWORD 保持一致；
#   * 独立/托管 PostgreSQL 场景：这两个密码对应 init.sql 的 psql 变量
#     ragkb_app_password / ragkb_migrator_password，见 docs/04-数据库设计.md §9。
RAGKB_APP_PASSWORD=
RAGKB_MIGRATOR_PASSWORD=

# Redis 认证密码（redis-server --requirepass；deploy.sh 首次运行自动生成）
#   * 强制启用认证，公网暴露时绝不允许无密码；
#   * 后端接入 Redis 时，连接串需带此密码。
REDIS_PASSWORD=

# 中间件公网绑定地址（默认不设 = 仅本机 127.0.0.1，安全姿态）
#   * 需公网直连 Navicat/应用时才取消注释设为 0.0.0.0；
#   * 同时需在云安全组放行 TCP 5432/6379/9000/9001，强烈建议源 IP 白名单（勿 0.0.0.0/0）。
# MIDDLEWARE_BIND_ADDRESS=0.0.0.0
