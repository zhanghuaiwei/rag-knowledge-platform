# =====================================================================
# deploy/compose 环境变量模板 —— 复制为 .env 后填写真实值
#
# ⚠️ 安全红线：
#   * .env 已加入仓库 .gitignore，绝不提交到 Git；
#   * 密码至少 16 位随机串，云服务器上通过受限 shell / 密钥管理设置；
#   * ragkb_app / ragkb_migrator 密码同时用于 deploy/ddl/init.sql 的 psql 变量。
# =====================================================================

# PostgreSQL superuser 密码（compose 启动 postgres 时使用）
POSTGRES_PASSWORD=

# MinIO 控制台 / S3 凭证
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# ---- 供 deploy/ddl/init.sql 执行时传入（不在此文件，由 psql -v 提供）----
# ragkb_app_password / ragkb_migrator_password 由部署命令注入，见 docs/09-部署运维指南.md
