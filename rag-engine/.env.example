# =====================================================================
# RAG Engine .env 示例（全量变量模板）
#
# 覆盖优先级（高→低）：
#   1. 代码里显式构造 Settings(...) 的字段参数
#   2. 真实 shell 环境变量
#   3. .env 文件（本文件）
#   4. <provider_type> 的预设 base_url / model 映射表
#   5. pydantic Field 默认值
#
# 想切不同厂商的大模型？只改 provider_type + api_key 即可，其它字段
# 自动应用预设；需要自定义 base_url / model / dimension 时再加。
# =====================================================================

# ---------- 通用运行时 ----------
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO

# ---------- 多租户 ----------
MULTI_TENANCY_ENABLED=true
DEFAULT_TENANT_ID=default

# ---------- 文档摄取 / 解析 ----------
APP_BUCKET=documents
INGEST_DEFAULT_CHUNK_SIZE=500
INGEST_DEFAULT_CHUNK_OVERLAP=50
MAX_IN_MEMORY_TASKS=1024

# ---------- 召回 ----------
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.15

# ---------- 生成 ----------
GENERATION_TEMPERATURE=0.1
GENERATION_MAX_TOKENS=1024
GENERATION_TIMEOUT_MS=120000
# 是否要求“不命中文档时拒绝回答”（默认 true → 发 NO_ANSWER 占位）
GENERATION_FAIL_CLOSED=true

# ---------------------------------------------------------------------
# LLM 路由（必填；切换只改 provider_type 和 api_key）
# provider_type 可选值：
#   dashscope | siliconflow | deepseek | zhipu | anthropic | openai_compatible | noop
#   （选 dashscope/siliconflow/deepseek/zhipu 时，base_url / model 自动应用预设，不必写）
# ---------------------------------------------------------------------
LLM_PROVIDER_TYPE=dashscope
LLM_API_KEY=sk-xxxxxxx

# 下面两项默认由 provider_type 预设填充；需要显式覆盖时再写
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# 超时（毫秒）与网关自定义请求头（格式 Header1:Val1,Header2:Val2）
LLM_TIMEOUT_MS=120000
# LLM_EXTRA_HEADERS=X-Trace-Id:xxx,X-Authority:internal-gateway

# ---------------------------------------------------------------------
# Embedding 路由（必填）
# provider_type 可选值：dashscope | siliconflow | zhipu | openai_compatible | noop
# ---------------------------------------------------------------------
EMBEDDING_PROVIDER_TYPE=dashscope
EMBEDDING_API_KEY=sk-xxxxxxx

# 预设映射（dashscope→text-embedding-v3/1024，siliconflow→BAAI/bge-m3/1024 …），无需手工覆盖
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=8
# EMBEDDING_EXTRA_HEADERS=

# ---------------------------------------------------------------------
# 重排（默认本地词项精排，无需额外配置）
# provider_type: disabled(=本地词项精排) | remote | noop
# ---------------------------------------------------------------------
RERANKER_PROVIDER_TYPE=disabled
# RERANKER_BASE_URL=
# RERANKER_API_KEY=
# RERANKER_MODEL=
# RERANKER_TIMEOUT_MS=5000
# RERANKER_EXTRA_HEADERS=

# ---------------------------------------------------------------------
# 内容安全（默认 disabled；noop 永远放行）
# provider_type: disabled | dashscope | noop
# ---------------------------------------------------------------------
SAFETY_PROVIDER_TYPE=disabled
# SAFETY_API_KEY=
# SAFETY_TIMEOUT_MS=3000
# SAFETY_EXTRA_HEADERS=

# ---------- MinIO 对象存储（真实摄取闭环必填）----------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
MINIO_SECURE=false

# ---------- Postgres + pgvector（真实检索闭环必填）----------
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag
PGVECTOR_ENABLED=false
# 表名前缀，避免同库多环境冲突
DOCUMENT_TABLE_NAME=rag_documents
CHUNK_TABLE_NAME=rag_chunks
VECTOR_TABLE_NAME=rag_vectors

# ---------- HTTP 连接池 / 反向代理头 ----------
HTTP_POOL_SIZE=20
HTTP_POOL_MAX_OVERFLOW=50

# =====================================================================
# 多厂商快速切换示例（二选一，按需复制到上方同名变量）
# =====================================================================

# ---- 例 A：阿里云 DashScope（默认）
# LLM_PROVIDER_TYPE=dashscope
# LLM_API_KEY=sk-xxxxxxxx
# EMBEDDING_PROVIDER_TYPE=dashscope
# EMBEDDING_API_KEY=sk-xxxxxxxx

# ---- 例 B：硅基流动 SiliconFlow（便宜、模型多）
# LLM_PROVIDER_TYPE=siliconflow
# LLM_API_KEY=sk-xxxxxxxx
# EMBEDDING_PROVIDER_TYPE=siliconflow
# EMBEDDING_API_KEY=sk-xxxxxxxx

# ---- 例 C：DeepSeek
# LLM_PROVIDER_TYPE=deepseek
# LLM_API_KEY=sk-xxxxxxxx

# ---- 例 D：智谱 Zhipu / ChatGLM
# LLM_PROVIDER_TYPE=zhipu
# LLM_API_KEY=xxxxxxxxxxxx
# EMBEDDING_PROVIDER_TYPE=zhipu
# EMBEDDING_API_KEY=xxxxxxxxxxxx

# ---- 例 E：Anthropic 原生（需 pip install anthropic>=0.40）
# LLM_PROVIDER_TYPE=anthropic
# LLM_API_KEY=sk-ant-xxxxxxxx
# LLM_MODEL=claude-3-5-sonnet-20241022

# ---- 例 F：走自建 / 私有 OpenAI 兼容网关
# LLM_PROVIDER_TYPE=openai_compatible
# LLM_BASE_URL=https://your-own-gateway.example.com/v1
# LLM_API_KEY=xxxxxx
# LLM_MODEL=your-internal-model-name
# EMBEDDING_PROVIDER_TYPE=openai_compatible
# EMBEDDING_BASE_URL=https://your-own-gateway.example.com/v1
# EMBEDDING_API_KEY=xxxxxx
# EMBEDDING_MODEL=bge-large-zh-v1.5
# EMBEDDING_DIMENSION=1024

# ---- 例 G：Noop（本地测试，不发任何模型请求）
# LLM_PROVIDER_TYPE=noop
# EMBEDDING_PROVIDER_TYPE=noop
# SAFETY_PROVIDER_TYPE=noop
