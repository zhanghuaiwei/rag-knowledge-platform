# rag-engine 本地安全默认配置。复制为 .env 后按环境修改；.env 已被仓库忽略。

# 服务标识与环境
RAG_ENGINE_SERVICE_NAME=rag-engine
RAG_ENGINE_SERVICE_VERSION=0.2.0-SNAPSHOT
RAG_ENGINE_ENVIRONMENT=local

# Uvicorn 监听参数；通过 `uv run python -m rag_engine` 启动时生效。
# 默认只监听本机。容器内需要对外监听时显式改为 0.0.0.0，并由网络策略限制来源。
RAG_ENGINE_HOST=127.0.0.1
RAG_ENGINE_PORT=8000
RAG_ENGINE_RELOAD=false

# 应用与诊断
RAG_ENGINE_LOG_LEVEL=INFO
RAG_ENGINE_DOCS_ENABLED=true
RAG_ENGINE_ROOT_PATH=

# 最小实现使用的有界内存任务仓库；生产必须替换为持久化 task/outbox + worker。
RAG_ENGINE_MAX_IN_MEMORY_TASKS=1024

# 当前唯一可执行的 provider。disabled 会关闭联调用本地词项精排。
RAG_ENGINE_RERANKER_PROVIDER=local

# ============================================================================
# 最小 RAG 链路（2026-08-17 新增）。复制 .env 后按环境填写。
# ⚠️ 密钥型配置（api_key / secret_key / 密码）绝不提交到 Git。
# pgvector_enabled=false 时保持 minimal（摄取/问答 fail-closed），用于测试/降级。
# ============================================================================

# pgvector：向量写入/检索（chunk_meta.embedding），需先在 PG 启用 vector 扩展。
#   连接串格式：postgresql://user:password@host:5432/ragkb
RAG_ENGINE_PGVECTOR_ENABLED=true
RAG_ENGINE_DATABASE_URL=

# MinIO/S3：读取原始文档（object_key 即对象名；与 service ragkb.storage.minio.* 对齐）。
RAG_ENGINE_MINIO_ENDPOINT=http://localhost:9000
RAG_ENGINE_MINIO_ACCESS_KEY=
RAG_ENGINE_MINIO_SECRET_KEY=
RAG_ENGINE_MINIO_BUCKET=kb-bucket-0814

# Embedding：OpenAI 兼容（通义 DashScope 默认）。维度须与 V0.6 迁移 vector(1024) 一致。
RAG_ENGINE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_ENGINE_EMBEDDING_API_KEY=
RAG_ENGINE_EMBEDDING_MODEL=text-embedding-v3
RAG_ENGINE_EMBEDDING_DIMENSION=1024

# LLM：OpenAI 兼容，流式生成。
RAG_ENGINE_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_ENGINE_LLM_API_KEY=
RAG_ENGINE_LLM_MODEL=qwen-plus
RAG_ENGINE_LLM_TIMEOUT_MS=120000

# 检索阈值：余弦相似度低于该值视为无证据，直接 NO_ANSWER 不调 LLM。
RAG_ENGINE_RETRIEVAL_MIN_SCORE=0.30

# 如需从其他文件加载配置，在启动进程的 shell/容器环境设置：
# RAG_ENGINE_ENV_FILE=/run/secrets/rag-engine.env
# 不要在这里提交对象存储、模型或搜索服务的密钥；对应 adapter 实现后使用 Secret 注入。
