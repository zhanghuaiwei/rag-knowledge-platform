# rag-engine 本地安全默认配置。复制为 .env 后按环境修改；.env 已被仓库忽略。

# 服务标识与环境
RAG_ENGINE_SERVICE_NAME=rag-engine
RAG_ENGINE_SERVICE_VERSION=0.2.0-SNAPSHOT
RAG_ENGINE_ENVIRONMENT=local

# Uvicorn 监听参数；通过 `uv run python -m rag_engine` 启动时生效。
# 默认只监听本机。容器内需要对外监听时显式改为 0.0.0.0，并由网络策略限制来源。
RAG_ENGINE_HOST=127.0.0.1
RAG_ENGINE_PORT=8000
RAG_ENGINE_RELOAD=false

# 应用与诊断
RAG_ENGINE_LOG_LEVEL=INFO
RAG_ENGINE_DOCS_ENABLED=true
RAG_ENGINE_ROOT_PATH=

# 最小实现使用的有界内存任务仓库；生产必须替换为持久化 task/outbox + worker。
RAG_ENGINE_MAX_IN_MEMORY_TASKS=1024

# 当前唯一可执行的 provider。disabled 会关闭联调用本地词项精排。
RAG_ENGINE_RERANKER_PROVIDER=local

# 如需从其他文件加载配置，在启动进程的 shell/容器环境设置：
# RAG_ENGINE_ENV_FILE=/run/secrets/rag-engine.env
# 不要在这里提交对象存储、模型或搜索服务的密钥；对应 adapter 实现后使用 Secret 注入。
