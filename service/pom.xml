<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.1</version>
    <relativePath/>
  </parent>

  <groupId>com.ragkb</groupId>
  <artifactId>ragkb-service</artifactId>
  <version>0.2.0-SNAPSHOT</version>
  <name>ragkb-service</name>
  <description>通用企业知识库平台 — 领域 API 服务（v0.2 模块化单体骨架）</description>

  <properties>
    <java.version>21</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- 认证：form 模式账号密码登录（开发）/ oidc 模式（生产），由 ragkb.auth.mode 切换 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-client</artifactId>
    </dependency>
    <!-- Redis：refresh token 族存储 + access token 黑名单（JWT 认证，form 模式） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <!-- JWT 签发/校验：jjwt 0.12.x（Spring Boot 3.4 不托管版本，显式固定）。
         impl/jackson 为 runtime，与官方三件套用法一致。 -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>0.12.6</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>0.12.6</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>0.12.6</version>
      <scope>runtime</scope>
    </dependency>

    <!-- 数据访问：MyBatis-Plus（Spring Boot 3 starter）+ PostgreSQL 驱动。
         由 ragkb.db.enabled 开关控制，未启用时不初始化数据源，保持脚手架无数据库可启动。
         mybatis-plus-jsqlparser：3.5.9+ 分页插件拆分为独立模块（PaginationInnerInterceptor）。 -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
      <version>3.5.17</version>
    </dependency>
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-jsqlparser</artifactId>
      <version>3.5.17</version>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <!-- compile scope：PostgresJsonbTypeHandler 编译期需要 org.postgresql.util.PGobject
           以便把 JSONB 列绑定为 PGobject(type=jsonb)，避免 varchar→jsonb 隐式转换失败。
           驱动在运行期本就在 classpath，scope 仅放宽编译期可见性。 -->
      <scope>compile</scope>
    </dependency>

    <!-- 对象存储：MinIO Java SDK（S3 兼容）。
         由 ragkb.storage.type 切换 local / minio（见 application.yml）；
         领域层只依赖 ObjectStorePort，不感知具体 SDK。 -->
    <dependency>
      <groupId>io.minio</groupId>
      <artifactId>minio</artifactId>
      <version>8.5.14</version>
    </dependency>

    <!-- 测试 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
