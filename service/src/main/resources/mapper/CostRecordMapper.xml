<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ragkb.service.modules.analytics.persistence.mapper.CostRecordMapper">

    <!--
        cost_record 表自定义查询（analytics 聚合）：
        · 按 tenant_id 隔离 + del_flag = 0（手写 XML 需显式逻辑删除过滤）；
        · 审计列名对齐 V0.3 迁移：create_time；
        · 表当前无写入方时查询自然返回空列表 / 空桶，服务层不造假数据。
    -->

    <!-- 按模型聚合的 Token 成本行映射。 -->
    <resultMap id="ModelCostRowMap" type="com.ragkb.service.modules.analytics.persistence.query.ModelCostRow">
        <result property="modelName" column="model_name"/>
        <result property="tokenIn" column="token_in"/>
        <result property="tokenOut" column="token_out"/>
        <result property="cost" column="cost"/>
        <result property="calls" column="calls"/>
    </resultMap>

    <!-- 按时间桶聚合的成本行映射。 -->
    <resultMap id="DailyCostBucketRowMap" type="com.ragkb.service.modules.analytics.persistence.query.DailyCostBucketRow">
        <result property="statDate" column="stat_date"/>
        <result property="cost" column="cost"/>
    </resultMap>

    <!--
        按模型聚合 Token 与成本（getTokenCosts 事实源）：
        · 覆盖 EMBEDDING / RERANK / LLM / OCR 全场景计费记录；
        · 按成本降序，贵模型排前（前端表格展示顺序）。
    -->
    <select id="selectModelCosts" resultMap="ModelCostRowMap">
        SELECT
            model_name,
            COALESCE(SUM(token_in), 0)::bigint  AS token_in,
            COALESCE(SUM(token_out), 0)::bigint AS token_out,
            COALESCE(SUM(cost), 0)              AS cost,
            COUNT(*)::bigint                    AS calls
        FROM cost_record
        WHERE tenant_id = #{tenantId}
          AND del_flag = 0
          AND create_time >= #{since}
        GROUP BY model_name
        ORDER BY SUM(cost) DESC, model_name
    </select>

    <!--
        按时间桶聚合全场景成本（getDailyUsage 每日真实成本）：
        · 与用量桶同 bucket / 同时区，服务层按 stat_date 对齐合并。
    -->
    <select id="selectDailyCosts" resultMap="DailyCostBucketRowMap">
        SELECT
            to_char(date_trunc(#{bucket}, create_time AT TIME ZONE #{tz}), 'YYYY-MM-DD') AS stat_date,
            COALESCE(SUM(cost), 0)                                                        AS cost
        FROM cost_record
        WHERE tenant_id = #{tenantId}
          AND del_flag = 0
          AND create_time >= #{since}
        GROUP BY stat_date
        ORDER BY stat_date
    </select>

</mapper>
