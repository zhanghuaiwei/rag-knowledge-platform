<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ragkb.service.modules.admin.persistence.mapper.WebhookSubscriptionMapper">

    <!--
        webhook_subscription 表自定义 SQL。
        单表 CRUD 由 BaseMapper 提供；本处只处理 JSONB 列（event_types）的显式插入。
    -->

    <!--
        JSONB 强转插入：event_types 必须是合法 JSON 数组字符串（服务层已去重序列化）。
        useGeneratedKeys 回填自增主键到实体 id，供创建响应与审计记录使用。
        status/create_time 等显式落值；update_time/del_flag 由数据库默认值兜底。
    -->
    <insert id="insertWithJsonb" useGeneratedKeys="true" keyProperty="entity.id" keyColumn="id">
        INSERT INTO webhook_subscription (
            tenant_id, name, target_url, event_types, secret_ref, status
        ) VALUES (
            #{entity.tenantId}, #{entity.name}, #{entity.targetUrl},
            CAST(#{entity.eventTypes} AS jsonb), #{entity.secretRef}, #{entity.status}
        )
    </insert>

</mapper>
