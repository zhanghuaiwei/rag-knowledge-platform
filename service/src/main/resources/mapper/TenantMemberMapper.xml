<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ragkb.service.modules.identity.persistence.mapper.TenantMemberMapper">

    <!--
        tenant_member 表自定义查询。
        单表 CRUD 由 BaseMapper 提供；跨表 JOIN（sys_tenant / tenant_member_role）在此定义，
        供 JdbcIdentityDirectory 组装成员关系（不跨 Java 模块依赖 tenant 的持久化层）。
    -->

    <resultMap id="TenantMembershipRowMap" type="com.ragkb.service.modules.identity.persistence.row.TenantMembershipRow">
        <result property="tenantId" column="tenant_id"/>
        <result property="tenantCode" column="tenant_code"/>
        <result property="tenantName" column="tenant_name"/>
        <result property="policyVersion" column="policy_version"/>
        <result property="role" column="role"/>
    </resultMap>

    <sql id="membershipJoinColumns">
        SELECT tm.tenant_id,
               t.code          AS tenant_code,
               t.name          AS tenant_name,
               t.policy_version,
               tmr.role
        FROM tenant_member tm
        JOIN sys_tenant t
          ON t.id = tm.tenant_id
         AND t.status = 'ACTIVE'
         AND t.del_flag = 0
        LEFT JOIN tenant_member_role tmr
          ON tmr.tenant_id = tm.tenant_id
         AND tmr.user_id = tm.user_id
         AND tmr.del_flag = 0
        WHERE tm.user_id = #{userId}
          AND tm.status = 'ACTIVE'
          AND tm.del_flag = 0
    </sql>

    <select id="selectActiveMembershipRows" resultMap="TenantMembershipRowMap">
        <include refid="membershipJoinColumns"/>
        ORDER BY tm.tenant_id, tmr.role
    </select>

    <select id="selectMembershipRows" resultMap="TenantMembershipRowMap">
        <include refid="membershipJoinColumns"/>
          AND tm.tenant_id = #{tenantId}
        ORDER BY tmr.role
    </select>

</mapper>
